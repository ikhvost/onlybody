    "uiYoutubeGoogleUsesDeviceAndViewingDataAndCookiesFor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube (Google) uses device and viewing data and cookies for playback, measurement and non-personalized ads."
          }

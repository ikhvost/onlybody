        }
      }
    },
    "uiDurationIsYourTargetTheEstimateBelowFollowsYourSets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration is your target; the estimate below follows your sets. Changing set rest applies to all exercises."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість — ваша ціль; оцінка нижче залежить від підходів. Зміна відпочинку застосовується до всіх вправ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas trwania to Twój cel; poniższy szacunek zależy od serii. Zmiana przerwy dotyczy wszystkich ćwiczeń."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauer ist dein Ziel; die Schätzung unten basiert auf deinen Sätzen. Änderungen der Satzpause gelten für alle Übungen."

    "uiGoogleProcessesTechnicalDataAndVideoActivityForPlaybackSecurity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google processes technical data and video activity for playback, security, measurement and non-personalized ads. Turning videos off stops embedded YouTube connections; it does not delete data already received by Google."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Google обробляє технічні дані й дані переглядів для відтворення, безпеки, вимірювання та неперсоналізованої реклами. Вимкнення відео зупиняє підключення до YouTube, але не видаляє вже отримані Google дані."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google przetwarza dane techniczne i aktywność oglądania na potrzeby odtwarzania, bezpieczeństwa, pomiarów i reklam niespersonalizowanych. Wyłączenie filmów zatrzymuje połączenia z YouTube, ale nie usuwa danych już otrzymanych przez Google."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google verarbeitet technische Daten und Videoaktivitäten für Wiedergabe, Sicherheit, Messungen und nicht personalisierte Werbung. Das Deaktivieren beendet eingebettete YouTube-Verbindungen, löscht aber keine bereits von Google empfangenen Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google traite les données techniques et l’activité vidéo pour la lecture, la sécurité, les mesures et les publicités non personnalisées. Désactiver les vidéos coupe les connexions YouTube intégrées, sans supprimer les données déjà reçues par Google."
          }
        }
      }
    },

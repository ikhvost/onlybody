        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart selection uses this time budget. Changing set rest applies to all exercises."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автопідбір враховує цей час. Зміна відпочинку між підходами застосовується до всіх вправ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",

          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Auswahl richtet sich nach dieser Zeit. Änderungen der Satzpause gelten für alle Übungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix automatique respecte cette durée. La modification du repos s’applique à tous les exercices."

    "uiSmartDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movements are picked daily from your targets. Switch to “I choose” to build manually."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправи щодня підбираються за цільовими м’язами. Перейдіть до «Обираю самостійно», щоб скласти тренування вручну."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenia są dobierane codziennie do grup docelowych. Wybierz „Wybieram samodzielnie”, aby ułożyć trening ręcznie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übungen werden täglich anhand deiner Zielmuskeln gewählt. Wechsle zu „Selbst wählen“, um dein Training selbst zusammenzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices sont choisis chaque jour selon vos muscles ciblés. Passez à « Je choisis » pour composer la séance."
          }
        }
      }
    },

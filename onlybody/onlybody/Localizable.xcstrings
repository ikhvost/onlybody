    "uiOneReminderOnYourScheduledTrainingDaysEvenIfYou": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reminder on your scheduled training days, even if you've already trained. Uses your device's local time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне нагадування в заплановані дні тренувань, навіть якщо ви вже тренувалися. За місцевим часом пристрою."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno przypomnienie w zaplanowane dni treningowe, nawet po ukończeniu treningu. Według czasu lokalnego urządzenia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung an geplanten Trainingstagen, auch wenn du schon trainiert hast. Es gilt die lokale Gerätezeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel les jours d’entraînement prévus, même si vous avez déjà fait votre séance. Utilise l’heure locale de l’appareil."
          }
        }
      }
    },
    "uiNotificationsAreDisabledInIosSettingsTurnOnWorkoutReminders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled in iOS Settings. Turn on Workout reminders to open Settings and allow notifications."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнені в налаштуваннях iOS. Увімкніть нагадування про тренування, щоб відкрити налаштування й дозволити сповіщення."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone w ustawieniach iOS. Włącz przypomnienia o treningu, aby otworzyć ustawienia i zezwolić na powiadomienia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind in den iOS-Einstellungen deaktiviert. Aktiviere Trainingserinnerungen, um die Einstellungen zu öffnen und Mitteilungen zu erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées dans les réglages iOS. Activez les rappels d’entraînement pour ouvrir les réglages et autoriser les notifications."
          }
        }
      }
    },
    "uiAddTrainingDaysToAWorkoutToReceiveReminders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add training days to a workout to receive reminders."

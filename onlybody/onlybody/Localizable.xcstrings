        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube (Google) використовує дані пристрою й переглядів та cookies для відтворення, вимірювання й неперсоналізованої реклами."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube (Google) używa danych urządzenia i oglądania oraz plików cookie do odtwarzania, pomiarów i reklam niespersonalizowanych."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube (Google) verwendet Geräte- und Wiedergabedaten sowie Cookies für die Wiedergabe, Messungen und nicht personalisierte Werbung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube (Google) utilise les données de l’appareil et de visionnage ainsi que des cookies pour la lecture, les mesures et les publicités non personnalisées."
          }
        }
      }
    },

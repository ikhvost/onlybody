# macOS and Xcode
.DS_Store
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
DerivedData/

# Build artifacts
.build/
.swiftpm/
*.ipa
*.dSYM.zip
*.dSYM

# SQLite transient files must never be bundled.
onlybody/Products/*/Resources/SeedStore/*.store-wal
onlybody/Products/*/Resources/SeedStore/*.store-shm

# Local video review records and evidence; keep on disk, outside version control.
Scripts/ExerciseMedia/Reviews/

# Local release artifacts; version and build history lives in CHANGELOG.md.
/Release/

# Generated marketing exports and local simulator captures; retain editable sources.
/Assets/Marketing/Captures/
/Assets/Marketing/Artwork/**/*.png
/Assets/Marketing/Artwork/**/*.jpg
/Assets/Marketing/Artwork/manifest.json
/Assets/Marketing/Artwork/*verification.json
/Assets/Marketing/localizations/
/Assets/Marketing/index.html
/Assets/Marketing/verification.json
/Assets/Marketing/*.zip
